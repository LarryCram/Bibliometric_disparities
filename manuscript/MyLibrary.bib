@article{gowLecturersViewsTheir1992,
  title = {Lecturers' Views of Their Teaching Practices: Implications for Staff Development Needs},
  author = {Gow, L. and Kember, D. and Sivan, A.},
  year = 1992,
  journal = {Higher Education Research and Development},
  volume = {11},
  number = {2},
  pages = {135--149},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436920110203},
  abstract = {The purpose of the study was to determine the ways lecturing staff at a polytechnic in Hong Kong approach their teaching and then to make inferences about their staff development needs. Semi-structured interviews were conducted individually with 39 full-time lecturing staff to determine their views on their teaching practices, the reasons some students fail to achieve the course objectives, the changes they would like to make to their teaching, the barriers standing in their way and the strategies they could use to overcome these barriers. Transcripts were analysed independently by three raters and themes extracted. There was a mismatch between the interviewees' perceptions of the goals of higher education and what they were doing in practice. While they stated that the goals of higher education were to encourage problem-solving or independent learning, in reality they were aiming for the more narrow goal of developing in their students the specific job-related skills they saw as necessary for their discipline. Three categories of reasons were given for why students might fail to achieve course objectives: blame the student; blame the lecturer; and blame the system. A large proportion of the respondents indicated that they would like to change their teaching practices but were not certain about the specific changes they would like to make, although a change towards more interactive teaching was mentioned by a few. Barriers to change included lack of resources, student resistance and inadequate teacher training. Implications of these findings for staff development are discussed in light of findings from related studies conducted in other parts of the world. Action research is suggested as a viable option for staff development. Copyright \copyright{} 1992, Taylor \& Francis Group, LLC. All rights reserved.},
  langid = {english}
}

@article{goyanesWhenCitationCounts2025,
  title = {When citation counts don't count: detecting author citation discrepancies across bibliographic databases to improve research evaluations},
  shorttitle = {When citation counts don't count},
  author = {Goyanes, Manuel and {Ordu{\~n}a-Malea}, Enrique},
  year = 2025,
  month = dec,
  journal = {Scientometrics},
  issn = {1588-2861},
  doi = {10.1007/s11192-025-05506-9},
  urldate = {2026-01-04},
  abstract = {Measuring academic performance through citation counts and derived indicators has become a sacred ritual in contemporary research evaluations. In this well-established liturgy, Google Scholar (GS) has become a widely used tool among researchers due to its accessibility and broad coverage. While the Bibliometrics community has consistently criticized GS for its lack of editorial control and opaque indexing criteria, its indicators are used to assess research impact in particular disciplines. This practice may lead to questionable citation practices, which only become evident when compared with more curated databases, such as Web of Science (Wos). This letter theoretically introduces and empirically tests an easy-to-implement indicator (the Citation Discrepancy Index, CDI) designed to explore the often-ignored extreme discrepancies in author citation counts across bibliographic databases and scientific fields. While some discrepancy is expected due to differences in coverage and publishing practices, this indicator might assist research evaluation committees in identifying cases where the divergence exceeds a reasonable or acceptable threshold, potentially signalling inconsistencies that merit closer scrutiny. Importantly, high CDI scores should be interpreted with caution: they are diagnostic signals of potential citation inconsistencies, not evidence of misconduct. To provide empirical support for the proposed indicator, several field-sensitive discrepancy thresholds are built to detect GS profiles requiring a full qualitative review.},
  langid = {english},
  file = {/home/lc/Zotero/storage/VR3VJQGZ/Goyanes and Orduña-Malea - 2025 - When citation counts don’t count detecting author citation discrepancies across bibliographic datab.pdf}
}

@article{grabherTemporaryArchitecturesLearning2004,
  title = {Temporary Architectures of Learning: Knowledge Governance in Project Ecologies},
  author = {Grabher, Gernot},
  year = 2004,
  month = nov,
  journal = {Organization Studies},
  volume = {25},
  number = {9},
  pages = {1491--1514},
  doi = {10.1177/0170840604047996},
  abstract = {This paper is motivated by the intention to contribute to a contextual understanding of projects. More specifically, the analysis starts from the assumption that essential processes of creating and sedimenting knowledge accrue at the interface between projects and the organizations, communities, and networks in and through which projects operate. By adopting such a contextual perspective, the chief aim of the present study is to unfold a conceptual framework for analyzing processes of project-based learning. This conceptual framework is built around the notion of the project ecology. By consecutively disentangling the constitutive layers of project ecologies -- the core team, the firm, the epistemic community, and the personal networks -- the basic organizational architecture of project ecologies is revealed. This architecture is employed as a theoretical template for an exploration of learning processes in two ecologies which are driven by opposing logics of creating and sedimenting knowledge. In this comparative analysis, the cumulative learning logic of the software ecology in Munich is confronted with the disruptive learning regime in the London advertising ecology.}
}

