@article{sheehy-skeffingtonEffectsLowSocioeconomic2020,
  title = {The effects of low socioeconomic status on decision-making processes},
  author = {{Sheehy-Skeffington}, J},
  year = 2020,
  month = jun,
  journal = {CURRENT OPINION IN PSYCHOLOGY},
  volume = {33},
  pages = {183--188},
  issn = {2352-250X},
  doi = {10.1016/j.copsyc.2019.07.043},
  abstract = {Low income groups are often criticised for making decisions that harm their long-term life outcomes. This article reviews research that attempts to understand these decision-making patterns as a product of adaptive responses to the situation of low socioeconomic status. It proposes that low income contexts present socioecological cues concerning resource scarcity, environmental instability, and low subjective social status, which trigger a regulatory shift towards the present and the tuning of cognitive skills and focus to address immediate needs. These shifts in psychological processes lead to decisions that are rational in the proximal context of socioeconomic threat, but may hinder the achievement of more distal goals.},
  langid = {english},
