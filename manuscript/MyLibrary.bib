  keywords = {bibliometrics,CREDIBILITY,DECISION-SUPPORT MODEL,eWOM,EWOM,HOSPITALITY,IMPACT,INFORMATION,ONLINE HOTEL REVIEWS,RECOMMENDATIONS,SATISFACTION,social media,tourism,USER-GENERATED-CONTENT},
