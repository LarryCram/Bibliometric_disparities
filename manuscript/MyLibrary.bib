  issn = {2331-1975},
  doi = {10.1080/23311975.2025.2543049},
  abstract = {This study explores key determinants influencing sustainability performance, including sustainable leadership, organizational culture, organizational learning, organizational capability and digital marketing. The goal is to provide insights into enhancing business sustainability and competitiveness. A systematic literature review (SLR) was conducted using Scopus, following the PRISMA methodology. A total of 11,711 articles were identified, which were filtered based on relevance, peer-review status, and research methodology. After screening, 24 key articles were selected for in-depth analysis. Findings reveal that sustainable leadership improves performance through psychological safety and employee empowerment. Organizational culture strengthens governance, HRM, and outsourcing efficiency. Organizational learning enhances innovation and adaptability, while organizational capability improves resource management and financial performance. Government initiatives and technology adoption influence sustainability performance. Digital marketing plays a crucial role in enhancing firm adaptability and sustainability strategies. This study offers a comprehensive framework integrating multiple sustainability determinants, emphasizing the growing role of digital transformation in corporate sustainability.},
  langid = {english},
