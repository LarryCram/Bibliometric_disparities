@article{malfroyDoctoralSupervisionWorkplace2005,
  title = {Doctoral supervision, workplace research and changing pedagogic practices},
  author = {Malfroy, J.},
  year = 2005,
  journal = {Higher Education Research and Development},
  volume = {24},
  number = {2},
  pages = {165--178},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360500062961},
  abstract = {The pressures of new agendas, new students and new degrees are challenging traditional pedagogical frameworks in doctoral education. This article draws on an ethnographic study that examined the changing nature of doctoral supervision and the pedagogic practices that support the doctoral endeavour in programs that explicitly link research with workplace practice. While supervisors and students struggled with uncertainty and confusion, partly due to disjunction in expectations, the creative tensions of doctoral research and the relatively new research territory of the programs, the study found that more flexible processes were emerging in doctoral education. This article examines the increasing move, through the use of research seminars, to more collective models of supervision and collaborative knowledge sharing environments. It is argued that this powerful pedagogic practice, which is often overlooked in the focus on the dyadic relationship of supervision, developed the research capacity of students and provided a forum for imaginative explorations about researching practice. \copyright{} 2005, Taylor \& Francis Group, LLC.},
  langid = {english}
}

@article{maLiteratureReviewEnterprises2025,
  title = {A literature review of enterprises' digital transformation based on the LDA topic model},
  author = {Ma, {\relax MT} and Wu, {\relax XJ} and Wang, {\relax XQ}},
  year = 2025,
  month = oct,
  journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
  issn = {0953-7325},
  doi = {10.1080/09537325.2025.2578809},
  abstract = {Using 716 articles from 1999 to 2025 published in journals with an ABS ranking of three stars and above as the sample, we conduct a literature review of enterprises' digital transformation (EDT) via the Latent Dirichlet Allocation (LDA) topic model. By using manual coding and LDAvis visualisation tools, we found that existing studies focused on six main research topics, and these topics constitute the 'CTABC' framework. We not only identify three main streams of EDT, i.e. technological change, strategic transformation, and institutional change, but also demonstrate the current research status and gaps in terms of the contextual characteristics (C), theoretical perspectives (T), antecedents (A), behavioural processes (B), and consequences (C) of EDT. Finally, we suggest future research directions for EDT from the CTABC framework.},
  langid = {english},
  keywords = {CTABC framework,Enterprises' digital transformation,LDA topic model,literature review}
}

@incollection{malleMoralJudgments2021,
  title = {Moral Judgments},
  booktitle = {ANNUAL REVIEW OF PSYCHOLOGY, VOL 72},
  author = {Malle, {\relax BF}},
  editor = {Fiske, {\relax ST}},
  year = 2021,
  volume = {72},
  pages = {293--318},
  doi = {10.1146/annurev-psych-072220-104358},
  abstract = {Research on morality has increased rapidly over the past 10 years. At the center of this research are moral judgments-evaluative judgments that a perceiver makes in response to a moral norm violation. But there is substantial diversity in what has been called moral judgment. This article offers a framework that distinguishes, theoretically and empirically, four classes of moral judgment: evaluations, norm judgments, moral wrongness judgments, and blame judgments. These judgments differ in their typical objects, the information they process, their speed, and their social functions. The framework presented here organizes the extensive literature and provides fresh perspectives on measurement, the nature of moral intuitions, the status of moral dumbfounding, and the prospects of dual-process models of moral judgment. It also identifies omitted questions and sets the stage for a broader theory of moral judgment, which the coming decades may bring forth.},
  isbn = {0066-4308},
  langid = {english},
  keywords = {ATTRIBUTION,BLAME,DECISION-MAKING,DISGUST,ethics,INFERENCES,INFORMATION,MODEL,moral cognition,moral psychology,NORM ENFORCEMENT,PSYCHOLOGY,PUNISHMENT,social cognition,social psychology}
}

