  keywords = {AGENCY,board of directors,CEO,corporate governance,CORPORATE GOVERNANCE,CSR performance,executive compensation,FIRM,IMPACT,KNOWLEDGE,OWNERSHIP,PERFORMANCE-MEASURES,stakeholder agency theory,TARGETS}
