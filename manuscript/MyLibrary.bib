@article{agasistiComparingEfficiencyCrosscountry2010,
  title = {Comparing efficiency in a cross-country perspective: the case of Italian and Spanish state universities},
  shorttitle = {Comparing efficiency in a cross-country perspective},
  author = {Agasisti, Tommaso and {P{\'e}rez-Esparrells}, Carmen},
