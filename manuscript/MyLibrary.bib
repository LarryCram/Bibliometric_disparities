@article{straussGroupAssessmentsDilemmas2007,
  title = {Group assessments: dilemmas facing lecturers in multicultural tertiary classrooms},
  author = {Strauss, P. and Alice, U.},
  year = 2007,
  journal = {Higher Education Research and Development},
  volume = {26},
  number = {2},
