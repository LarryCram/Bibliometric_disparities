@article{boekaertsSelfregulatedLearningNew1997,
  title = {Self-regulated learning: A new concept embraced by researchers, policy makers, educators, teachers, and students},
  author = {Boekaerts, Monique},
  year = 1997,
  journal = {Learning and Instruction},
  volume = {7},
  number = {2},
  pages = {161--186},
  abstract = {In the past decade self-regulated learning (SRL) has been studied extensively. It has been defined as a complex interactive process involving not only cognitive self-regulation but also motivational self-regulation. An increasing body of knowledge attests that cognitive self-regulation can be taught and that students who use these self-regulatory skills obtain better grades in the content domain to which these skills apply. However, students who self-regulate on one occasion may not self-regulate their studying on another occasion, despite the acknowledged benefits. It is argued that self-regulated learning can be domain-specific or domain-transcending, and that competent performers in a specific domain rely on different types of prior knowledge related to that domain. In this paper a conceptual review on self-regulated learning is offered on. Four major points will be addressed. First, six types of prior knowledge will be described. Second, it is documented that SRL can be a complex, demanding and deliberate activity, but also a simple, habitual and automatic activity. Third, it will be argued that we have covered some ground demonstrating that cognitive self-regulation can be taught. Fourth, motivational self-regulation will be addressed in an attempt to clarify its position in the six component model of self-regulated learning. Finally, our intervention program will be briefly described in an attempt to demonstrate how the various design recommendations given in the previous sections can be put to the test.}
}

@article{boekaertsSelfRegulationClassroomPerspective2005,
  title = {Self-Regulation in the Classroom: A Perspective on Assessment and Intervention},
  author = {Boekaerts, Monique and Corno, Lyn},
  year = 2005,
  journal = {Applied Psychology: An International Review},
  volume = {54},
  number = {2},
  pages = {199--231},
  issn = {0269994X},
  abstract = {There is no simple and straightforward definition of the construct of self-regulated learning. Theorists in educational psychology have narrowed the scope of students\^a\texteuro ™ capability to self-regulate through a focus on the academic side of education, namely on learning and achievement goals. However, the messy world of classroom learning creates a situation in which different goals compete for students\^a\texteuro ™ attention. Boekaerts\^a\texteuro ™ dual processing self-regulation model describes how learning goals interact with well-being goals. We propose that when students have access to well-refined volitional strategies manifested as good work habits, they are more likely to invest effort in learning and get off the well-being track when a stressor blocks learning. Shifting definitions of SRL have led to changing measurement procedures; researchers moved away from decontextualised measures of SRL to domain-specific measures and then on to context-sensitive measures. The validity and reliability of the first generation of SR assessment has been limited and several issues remain. Recently, researchers have designed assessment packages including new instruments that better capture self-regulation as a process (including for example traces of mental events, situational manipulations, and records of student work strategies). A combination of instruments is preferable over a single instrument for assessing self-regulation as a process and the effects of interventions to improve students\^a\texteuro ™ self-regulatory capacity. At present, many sound SRL interventions exist and some general lessons can be learned about classroom intervention research. (English) ABSTRACT FROM AUTHOR Il n\^a\texteuro ™y a pas de d\~A\copyright finition simple et univoque du concept d\^a\texteuro ™apprentissage autor\~A\copyright gul\~A\copyright. Des th\~A\copyright oriciens de psychologie de l\^a\texteuro ™\~A\copyright ducation ont r\~A\copyright duit l\^a\texteuro ™\~A\copyright ventail des aptitudes des\~A\copyright l\~A\textasciidieresis ves\~A~ s\^a\texteuro ™autor\~A\copyright guler en se focalisant sur le versant scolaire de l\^a\texteuro ™\~A\copyright ducation,\~A~ savoir l\^a\texteuro ™acquisition des connaissances et les objectifs de r\~A\copyright ussite. Toutefois, le monde complexe de l\^a\texteuro ™\~A\copyright tude en classe engendre une situation o\~A{$^1$} diff\~A\copyright rents buts entrent en concurrence aux yeux des\~A\copyright l\~A\textasciidieresis ves. Le mod\~A\textasciidieresis le d\^a\texteuro ™autor\~A\copyright gulation\~A~ double processus de Bookaerts montre que les deux objectifs que sont l\^a\texteuro ™\~A\copyright tude et le bien-\~Aªtre interagissent. Nous estimons que lorsque les\~A\copyright l\~A\textasciidieresis ves ont acc\~A\textasciidieresis s\~A~ des strat\~A\copyright gies autonomes bien au point se traduisant par de bonnes habitudes de travail, ils ont une plus grande probabilit\~A\copyright{} de se motiver pour les\~A\copyright tudes et de sauvegarder leur bien-\~Aªtre quand une source de stress bloque l\^a\texteuro ™apprentissage. (French) ABSTRACT FROM AUTHOR Copyright of Applied Psychology: An International Review is the property of Blackwell Publishing Limited and its content may not be copied or emailed to multiple sites or posted to a listserv without the copyright holder's express written permission. However, users may print, download, or email articles for individual use. This abstract may be abridged. No warranty is given about the accuracy of the copy. Users should refer to the original published version of the material for the full abstract. (Copyright applies to all Abstracts)},
  keywords = {ACHIEVEMENT motivation,EDUCATION,EDUCATIONAL psychology,GOAL (Psychology),LEARNING Psychology of}
}

@article{boekaertsSelfRegulationDomainsApplied2005,
  title = {Self-Regulation Across Domains of Applied Psychology: Is there an Emerging Consensus?},
  author = {Boekaerts, Monique and Maes, Stan and Karoly, Paul},
  year = 2005,
  journal = {Applied Psychology: An International Review},
  volume = {54},
  number = {2},
  pages = {149--154},
  issn = {0269994X},
  abstract = {The article focuses on emergence of self-regulation as an important topic in many areas of theoretical psychology. There has also been a growing recognition in applied psychology, education, public health and industry that goal-directed behavior is central to the well-being of individuals and collectives, that goal-guided self-regulation can be improved and that the impact of factors that threaten self-regulation can be reduced. Researchers agree that for the adoption and maintenance of effective self-regulation strategies to take place, heavy demands and responsibilities are placed on the individual. There has also been a growing awareness that for effective self-regulation to develop, demands and responsibilities are also placed on the organizations and communities within which individuals live, learn, and work.},
  keywords = {ATTITUDE (Psychology),GOAL (Psychology),MOTIVATION (Psychology),PSYCHOLOGY Applied,RECOGNITION (Psychology),SELF-actualization (Psychology),SELF-efficacy}
}

@article{boekaertsSubjectiveCompetenceAppraisals1991,
  title = {Subjective competence, appraisals and self-assessment},
  author = {Boekaerts, Monique},
  year = 1991,
  journal = {Learning and Instruction},
  volume = {1},
  number = {1},
  pages = {1--17},
  abstract = {In this paper a distinction is made between subjective competence and objective competence. Several constructs have been introduced in the literature to refer to the individual's knowledge, beliefs and feelings about his competence. An overview of the most important constructs is given. A heuristic model of the affective learning process is presented and used as a framework for describing appraisal processes. The nature of a specific form of appraisal, viz. self-assessment, is outlined. It is argued that self-assessment should be a major component of any competence category and that it is a key variable in independent learning.}
