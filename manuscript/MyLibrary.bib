  journal = {JOURNAL OF CONSUMER AFFAIRS},
  volume = {48},
  number = {3},
  pages = {535--602},
  issn = {0022-0078},
  doi = {10.1111/joca.12050},
  abstract = {Amidst concerns about percentages of households that remain unbanked or underbanked, policy endeavors have emerged to promote financial inclusion by making financial products such as savings accounts readily available. While these endeavors have primarily concentrated on households, young people may be the front lines of financial inclusion because they may be more likely to be banked in young adulthood and beyond when they start off with savings accounts earlier in life. This article addresses young people's financial inclusion by comprehensively reviewing 60 research studies on young people's savings, discussing the role of the family in young people's financial inclusion, discussing financial inclusion from an institutional perspective, presenting policy implications, and identifying gaps in knowledge and opportunities for research. Policies that open savings accounts for young people early in life may be a promising strategy for extending financial inclusion and preventing unbanked or underbanked status later in life.},
