  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360903208112},
  abstract = {Extant academic literature, the media and views expressed by staff and students report that both local and international students are experiencing dissatisfaction with the lack of inter-cultural student interaction occurring in classrooms, group discussions and teamwork in post-graduate studies in the Australian higher education sector. It has been argued that increased interaction between local and international students may improve the overall student experience. This interpretive empirical study explores the potential of global study tours to increase inter-cultural student interaction through the provision of opportunities for greater cultural understandings. \copyright{} 2009 HERDSA.},
