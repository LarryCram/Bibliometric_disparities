@article{rorenStatusOrdersLocal2024,
  title = {Status Orders: Toward a Local Understanding of Status Dynamics in World Politics},
  author = {Roren, P},
  year = 2024,
  month = oct,
  journal = {INTERNATIONAL STUDIES REVIEW},
  volume = {26},
  number = {4},
  issn = {1521-9488},
  doi = {10.1093/isr/viae044},
  abstract = {This analytical essay highlights the importance of status orders in the study of status and prestige in world politics. Drawing on recent research in the field, I argue that understanding the particular social structures that regulate the status dynamics within social collectives is crucial to understanding how actors seek and receive status in world politics. I review the literature on status in IR and introduce the concept of status orders as context-specific and local social structures that determine what is considered prestigious within a particular group, community, or club. Using examples from war-making, nuclear weapons, and diplomatic practice, I argue that the fact that status dynamics is often produced locally and not globally forces us to focus less on "universal" aspirations for status, and more on where that actor sought status from and eventually according to which yardstick that actor experienced a change in status. Este ensayo anal \& iacute;tico destaca la importancia de los \& oacute;rdenes jer \& aacute;rquicos dentro del contexto del estudio de las jerarqu \& iacute;as y el prestigio en la pol \& iacute;tica mundial. Partimos de la base de investigaciones que se han llevado a cabo recientemente en este campo, y argumentamos que el hecho de comprender las estructuras sociales espec \& iacute;ficas que regulan las din \& aacute;micas en materia de jerarqu \& iacute;as dentro de los colectivos sociales resulta crucial para comprender c \& oacute;mo los agentes buscan y reciben mejoras con respecto a su posici \& oacute;n jer \& aacute;rquica en la pol \& iacute;tica mundial. Para ello, revisamos la literatura en materia de jerarqu \& iacute;as existente en el \& aacute;mbito de las RRII y presentamos el concepto de \& oacute;rdenes jer \& aacute;rquicos como estructuras sociales locales y espec \& iacute;ficas de este contexto, las cuales determinan lo que se considera prestigioso dentro de un grupo, comunidad o club en concreto. Utilizamos ejemplos procedentes de la guerra, las armas nucleares y la pr \& aacute;ctica diplom \& aacute;tica y argumentamos que el hecho de que la din \& aacute;mica de las jerarqu \& iacute;as se produzca, con frecuencia, localmente y no globalmente nos obliga a centrarnos menos en las aspiraciones "universales" a nivel de jerarqu \& iacute;as, y m \& aacute;s en aquellos lugares d \& oacute;nde ese agente llevo a cabo su b \& uacute;squeda en materia de jerarqu \& iacute;as, as \& iacute; como a fijarnos, finalmente, qu \& eacute; es lo que motiv \& oacute; que ese agente experimentara un cambio a nivel de jerarqu \& iacute;a. Cet essai analytique souligne l'importance des ordres de statuts dans l'\& eacute;tude du statut et du prestige en politique mondiale. Me fondant sur des travaux de recherche r \& eacute;cents dans le domaine, j'affirme qu'il est crucial de comprendre les structures sociales sp \& eacute;cifiques qui r \& eacute;gulent les dynamiques de statuts dans les collectifs sociaux pour comprendre comment les acteurs recherchent et re \& ccedil;oivent un statut en politique mondiale. Je passe en revue la litt \& eacute;rature sur le statut en RI et pr \& eacute;sente le concept d'ordres de statuts : des structures sociales locales et sp \& eacute;cifiques \& agrave; un contexte donn \& eacute;, qui d \& eacute;terminent ce que l'on consid \& egrave;re comme prestigieux au sein d'un certain groupe, club ou d'une certaine communaut \& eacute;. \& Agrave; l'aide d'exemples issus des guerres, des armes nucl \& eacute;aires et de la pratique diplomatique, j'affirme que le fait que les dynamiques de statuts soient souvent produites au niveau local, et non mondial, nous oblige \& agrave; nous concentrer moins sur les aspirations {$<<$} universelles {$>>$} de statut, et plus sur les sources aupr \& egrave;s desquelles les acteurs recherchent un statut et, finalement, par rapport \& agrave; quel indicateur l'acteur ressent un changement de statut.},
  langid = {english},
  keywords = {AMERICAN,as,GREAT POWER STATUS,IDENTITY,INTERNATIONAL SOCIETY CHINA,INTERVENTION,jerarqu & iacute,orden,order,ordre,PERMANENT REPRESENTATIVES,prestige,prestigio,RUSSIA,status,STATUS-INCONSISTENCY,STATUS-SEEKING,statut,UNITED-NATIONS}
}

