  keywords = {ANTECEDENTS,CONSEQUENCES,CUSTOMER SATISFACTION,DOMINANT LOGIC,education,EMPLOYEES,ENCOUNTERS,hospitality,MODEL,PERCEPTIONS,SCIENCE,Service management,service-dominant logic,WORLD}
