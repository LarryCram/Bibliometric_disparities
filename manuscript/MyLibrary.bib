@article{tuttWhereInteractionCollisions2008,
  title = {Where the Interaction Is: Collisions of the Situated and Mediated in Living Room Interactions},
  author = {Tutt, Dylan},
  year = 2008,
  month = oct,
  journal = {Qualitative Inquiry},
  volume = {14},
  number = {7},
  pages = {1157--1179},
  doi = {10.1177/1077800408322227},
  abstract = {This article presents three ethnographic tales of interactions with living room media to help recreate the experience of significant moments in time, of affective encounters at the interface in which there is a collision or confusion of situated and virtual worlds. It draws on a year-long video ethnography of the practice and performance of everyday interactions with living room media. By studying situated activity and the lived practice of (new) media, rather than taking an exclusive focus on the virtual as a detached space, this ethnographic work demonstrates how the situated and mediated clash, or are crafted into complex emotional encounters during everyday living room life.}
}

@article{twengeRaceSelfesteemMetaanalyses2002,
  title = {Race and self-esteem: Meta-analyses comparing Whites, Blacks, Hispanics, Asians, and American Indians and comment on Gray-Little and Hafdahl (2000)},
  author = {Twenge, {\relax JM} and Crocker, J},
  year = 2002,
  month = may,
  journal = {PSYCHOLOGICAL BULLETIN},
  volume = {128},
  number = {3},
  pages = {371--408},
  issn = {0033-2909},
  doi = {10.1037//0033-2909.128.3.371},
  abstract = {These meta-analyses examine race differences in self-esteem among 712 datapoints. Blacks scored higher than Whites on self-esteem measures (d = 0.19), but Whites scored higher than other racial minority groups, including Hispanics (d = - 0.09), Asians (d = - 0.30), and American Indians (d = - 0.21). Most of these differences were smallest in childhood and grew larger with age. Blacks' self-esteem increased over time relative to Whites', with the Black advantage not appearing until the 1980s. Black and Hispanic samples scored higher on measures without an academic self-esteem subscale. Relative to Whites, minority males had lower self-esteem than did minority females, and Black and Hispanic self-esteem was higher in groups with high socioeconomic status. The results are most consistent with a cultural interpretation of racial differences in self-esteem.},
  langid = {english},
  keywords = {AFRICAN-AMERICAN,COLLEGE-STUDENTS,ETHNIC-GROUPS,GENDER DIFFERENCES,GROUP IDENTIFICATION,HIGH-SCHOOL-STUDENTS,MENTAL-HEALTH,RACIAL IDENTITY,SOCIAL STIGMA,UNITED-STATES}
}

