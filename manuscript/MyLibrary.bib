  author = {Mason, Julie L. and Lei, Ming and {Faupel-Badger}, Jessica M. and Ginsburg, Erika P. and Seger, Yvette R. and DiJoseph, Leo and Schnell, Joshua D. and Wiest, Jonathan S.},
  year = 2013,
