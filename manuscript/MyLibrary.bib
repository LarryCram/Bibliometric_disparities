@article{bloxhamExternalPeerReview2015,
  title = {External peer review of assessment: an effective approach to verifying standards?},
  author = {Bloxham, S. and Hudson, J. and {den Outer}, B. and Price, M.},
  year = 2015,
  journal = {Higher Education Research and Development},
  volume = {34},
  number = {6},
  pages = {1069--1082},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2015.1024629},
  abstract = {There is growing international concern to regulate and assure standards in higher education. External peer review of assessment, often called external examining, is a well-established approach to assuring standards. Australian higher education is one of several systems without a history of external examining for undergraduate programmes that is currently considering the approach. What can entrants to external examining at that level learn from the UK higher education system's long history of external examining? To that end, this paper reports on a mixed methods research project designed to investigate current practices in how academic standards are conceived, constructed and applied by external examiners and debates the implications of the findings for the development of external examining in other countries. The findings suggest that the potential of experienced peers in a subject discipline to provide the assurance of standards is limited. It concludes by presenting various possible enhancements that might be considered. \copyright{} 2015 HERDSA.},
  langid = {english},
  keywords = {external examiners,higher education,quality assurance,standards},
