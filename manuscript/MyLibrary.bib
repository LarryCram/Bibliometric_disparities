  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2010.549462 10.1136/bmj.320.7226.50; McInnis, C., James, R., McNaught, C., (1995) First year on campus: Diversity in the initial experiences of Australian undergraduates, , Canberra: Australian Government Publishing Services; Milem, J.F., Chang, M.J., Antonio, A.L., (2005) Making diversity work on campus: A research-based perspective, , Washington, DC: Association of American Colleges and Universities; Morgan, D., Focus groups (1996) Annual Review of Sociology, 22, pp. 129-152; Pace, C.R., (1984) Student effort: A new key to assessing quality, , Los Angeles: University of California, Higher Education Research Institute, Project on the Study of Quality in Undergraduate Education; Pascarella, E.T., Terenzini, P.T., (2005) How college affects students: A third decade of research, , (Vol. 2). Indianapolis, IN: Jossey-Bass; Patton, M.Q., (1990) Qualitative evaluation and research methods, p. 2. , London: Sage; Pinar, W.F., Reynolds, W.M., Slattery, P., Taubman, P.M., (1995) Understand curriculum: An introduction to the study of historical and contemporary curriculum discourses, , New York: Peter Lang; Schutz, A., (1967) The phenomenology of the social world, , Evanston, IL: Northwestern University Press; Schwandt, T.A., Constructivist, interpretivist approaches to human inquiry (1998) The landscape of qualitative research: Theories and issues, pp. 221-259. , In: Denzin N. K., Lincoln Y. S., editors London: Sage; Sidanius, J., Levin, S., van Laar, C., Sears, D.O., (2008) The diversity challenge: Social identity and intergroup relations on the college campus, , New York: Rousell Sage; Sim, J., Collecting and analysing qualitative data: Issues raised by the focus group (1998) Methodological Issues in Nursing Research, 28 (2), pp. 345-352; Stern, G.G., (1970) People in context: Measuring person-environment congruence in education and industry, , New York: Wiley; Strange, C.C., Banning, J.H., (2001) Educating by design, , San Franscisco: Jossey-Bass; Tam, M., Measuring the effect of higher education on university students (2002) Quality Assurance in Education, 10 (4), pp. 223-228; Tinto, V., (1993) Leaving college: Rethinking the causes and cures of student attrition, p. 2. , Chicago, IL: University of Chicago Press; Watkins, D., Biggs, J., The paradox of the Chinese learning and beyond (2001) Teaching the Chinese learner: Psychological and pedagogical perspectives, pp. 3-26. , In: Watkins D., Biggs J., editors Hong Kong: The University of Hong Kong. Comparative Education Research Centre; Wilkinson, S., Focus group research (2004) Qualitative research, pp. 177-199. , In: Silverman D., editors London: Sage; Yorke, M., Longden, B., (2004) Retention and student success in higher education, p. 2. , Maidenhead, UK: Society for Research in Higher Education and Open University Press},
  abstract = {With more non-local (Mainland China and overseas) students admitted into the universities of Hong Kong, the student population on campus is becoming much more diversified. This study was a phenomenological inquiry into the social engagement experiences of local and non-local Chinese students in their first year at a university in Hong Kong. Qualitative data was obtained from 10 focus groups. The findings suggested that the majority of the students in the study were active in social engagement and most achieved a sense of belonging to the university or its sub-communities. The culture in student communities played an important role in students' social engagement. It pushed students to become intensively involved in out-of-class activities and challenged them to reflect on the direction in which they would carry this historical legacy forward in the diversifying campus. \copyright{} 2012 HERDSA.},
  langid = {english},
  keywords = {Chinese students,diversity,phenomenology,social engagement,student communities,student culture}
}

