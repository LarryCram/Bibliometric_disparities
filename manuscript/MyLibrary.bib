@article{pacesilaInsightsSocialResponsibility2020,
  title = {Insights on Social Responsibility of NGOS},
  author = {Pacesila, M and Colesca, {\relax SE}},
  year = 2020,
  month = jun,
  journal = {SYSTEMIC PRACTICE AND ACTION RESEARCH},
  volume = {33},
  number = {3},
  pages = {311--339},
  issn = {1094-429X},
  doi = {10.1007/s11213-020-09520-1},
  abstract = {The social responsibility of nongovernmental organizations starts from the values this sector defends. Despite the social vocation, a question arises as to whether the NGOs organizations are indeed responsible to society. Proponents of social responsibility of NGOs argue that good intentions and desire to do well are not enough to assign a status of social responsible actor to an organization. Through their activities, NGOs should prove their social role, meaning involving in meeting social needs and fighting social inequalities. In addition, they should make alliances with the business community to find solutions to society's problems and even put pressure on companies to adopt socially responsible behavior. Opponents counter that NGOs are not companies and therefore the concept of social responsibility is not relevant to the nongovernmental sector. Moreover, the non-profit-distributing character and the social nature of their activities give the idea that they are, in essence, socially responsible. In this context, the purpose of the present article is to provide an overview of the existing body of literature on social responsibility of nongovernmental organizations and identify the most relevant papers in the area and the topics of interest. A review of previous literature in the field has been carried out and 67 articles identified in 12 international databases have been investigated. The analysis highlighted that there is an obvious increase in the relevance of this issue within academic environment and several thematic trends arise in the research of the nongovernmental sector's social responsibility.},
  langid = {english},
  keywords = {BUSINESSES,COLLABORATION,CORPORATE-RESPONSIBILITY,CSR,DONATIONS,ENGAGEMENT,FOR-PROFIT,HUMAN-RIGHTS,NONPROFIT ORGANIZATIONS,PARTNERSHIPS,Sectorial expertise,Social actors,Social involvement,Social vocation,Transparency}
}

@book{pacheco-torgalAssessingMethodologicalDistortions2026,
  title = {Assessing Methodological Distortions in the Clarivate Highly Cited Researchers List: International Comparisons and a Reform Framework},
  shorttitle = {Assessing Methodological Distortions in the Clarivate Highly Cited Researchers List},
  author = {{PACHECO-TORGAL}, F.},
  year = 2026,
  month = may,
  doi = {10.21203/rs.3.rs-9750193/v1},
  abstract = {This paper examines methodological limitations in the Clarivate Highly Cited Researchers list and their implications for international comparisons of scientific influence. Focusing on the effects of whole counting, disciplinary citation differences, author disambiguation, and self-citation treatment, the study compares national representation in the 2024 Clarivate HCR list with corresponding shares in the Stanford Top 0.5\% Scientists dataset. A Distortion Ratio is introduced to quantify cross-list divergence at the country level, defined as the ratio between a country's HCR share and its Stanford annual share. The results show substantial variation across countries. China Mainland records the highest Distortion Ratio in the sample, while countries such as Norway, Japan, Italy, and Canada appear under-represented relative to their Stanford shares. These findings suggest that the HCR methodology may amplify structural advantages associated with large collaborative networks and field-specific citation practices, while disadvantaging research systems with different authorship and citation profiles. The paper also reviews evidence from the scientometric literature, including comparisons with Nobel laureates and prior studies on fractional counting, to assess the robustness and limitations of the HCR approach. It concludes by proposing a three-pillar reform framework based on fractional counting, stronger field normalisation, and improved author disambiguation combined with self-citation exclusion. The analysis does not treat the Stanford dataset as a definitive benchmark, but as a contrasting methodological reference that helps identify systematic cross-list discordance.},
  file = {/home/lc/Zotero/storage/ZQ262UL3/PACHECO-TORGAL - 2026 - Assessing Methodological Distortions in the Clarivate Highly Cited Researchers List International C.pdf}
}

