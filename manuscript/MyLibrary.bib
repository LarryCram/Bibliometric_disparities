@article{huismanStyleItTakes2016,
  title = {The style it takes: how do UK universities communicate their identity through welcome addresses?},
  author = {Huisman, J. and Mampaey, J.},
  year = 2016,
  journal = {Higher Education Research and Development},
  volume = {35},
  number = {3},
  pages = {502--515},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2015.1107889},
  abstract = {ABSTRACT: In times when universities are becoming less self-evident, these organisations may be confounded in terms of which aspects of their activities and performances they should communicate with their stakeholders. A related question -- central to our study -- is how they communicate. This paper analyses the style of one particular type of communication: welcome addresses of key spokespersons of UK universities. Building on the pertinent image and identity literature and using Speech Act Theory, we expected to find differences between universities by prestige and age and over time. We found that older universities use different styles compared to younger universities, and that there were also differences by prestige. We also found considerable changes over time. The findings suggest we should not see these welcome addresses as purely ceremonial, but as intentional messages with communication styles that reflect the organisational attributes of the university. \copyright{} 2015 HERDSA.},
  langid = {english},
  keywords = {communication,image,Speech Act Theory,UK,universities}
}

