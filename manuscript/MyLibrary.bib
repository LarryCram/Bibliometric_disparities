  keywords = {attachment to groups,ATTITUDES,coalition formation,COMPENSATORY CONTROL,CONSERVATISM,identity politics,IDEOLOGY,LOSS AVERSION,middle class,NEGATIVITY BIAS,RIGHT-WING AUTHORITARIANISM,SOCIAL-DOMINANCE ORIENTATION,SOCIETAL THREAT,status anxiety,UNITED-STATES},
