  doi = {10.1080/07294360.2012.750277 10.1057/palgrave.hep.8300140; Bourdieu, P., (1988) Homo academicus, , Cambridge, Cambridge,: Polity Press; Brown, P., Lauder, H., Ashton, D., (2011) The global auction: The broken promises of education, jobs and incomes, , Oxford, Oxford,: Oxford University Press; Clegg, S., Critical readings: Progress files and the production of the autonomous learner (2004) Teaching in Higher Education, 9 (3), pp. 287-298. , doi:10.1080/1356251042000216615; Clegg, S., Histories and institutional change: Understanding academic development practices in the global 'north' and 'south (2009) International Studies in the Sociology of Education, 19 (1), pp. 53-65. , doi:10.1080/09620210903057715; Clegg, S., Forms of knowing and academic development practice (2009) Studies in Higher Education, 34 (4), pp. 403-416. , doi:10.1080/03075070902771937; Clegg, S., Cultural capital and agency: Connecting critique and curriculum in higher education (2011) British Journal of Sociology of Education, 32 (1), pp. 95-110. , doi:10.1080/01425692.2011.527723; Clegg, S., On the problem of theorising: An insider account of research practice (2012) Higher Education Research & Development, 31 (3), pp. 407-418; Clegg, S., Conceptualising higher education research and/or academic development as 'fields': A critical analysis (2012) Higher Education Research & Development, 31 (5), pp. 667-678; Clegg, S., Bufton, S., Student support through personal development planning: Retrospection and time (2008) Research Papers in Education, 23 (4), pp. 1-16. , doi:10.1080/02671520701809833; Clegg, S., Stevenson, J., Willott, J., Blurring boundaries: Conceptions of the curricular and extracurricular in higher education (2010) Higher Education, 59 (5), pp. 615-626. , doi:10.1007/s10734-009-9269-y; Denzin, N.K., (1997) Interpretive ethnography: Ethnographic practices for the twenty-first century, , Thousand Oaks, CA, Thousand Oaks, CA,: Sage; Denzin, N.K., Lincoln, Y.S., (1994) Handbook of