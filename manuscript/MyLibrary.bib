@article{actonConversationsCulturalSustainability2017,
  title = {Conversations on cultural sustainability: stimuli for embedding Indigenous knowledges and ways of being into curriculum},
  author = {Acton, R. and Salter, P. and Lenoy, M. and Stevenson, R.},
  year = 2017,
  journal = {Higher Education Research and Development},
