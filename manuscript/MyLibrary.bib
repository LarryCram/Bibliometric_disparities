@article{bredellaImpactKL2Catalyst2022,
  title = {Impact of the KL2/Catalyst Medical Research Investigator Training (CMeRIT) Program on the careers of early-stage clinical and translational investigators},
  author = {Bredella, Miriam A. and McGroarty, Kate M. and Kolessin, Lucy and Bard, Linda F. and Hollenberg, Anthony N. and Rutkove, Seward B.},
  year = 2022,
  journal = {Journal of Clinical and Translational Science},
  volume = {6},
  number = {1},
  issn = {2059-8661},
  doi = {10.1017/cts.2022.7},
  abstract = {The Harvard Catalyst KL2/CMeRIT program is a 2-year mentored institutional career award that includes KL2 grants funded by National Institutes of Health (NIH) and CMeRIT grants funded by Harvard Catalyst nonfederal funds. The purpose of this study was to compare outcomes for early-stage investigators funded by the KL2/CMeRIT program to a group of applicants who were not chosen for support to assess the potential impact of the program on early career outcomes. Career data, including academic promotions, subsequent grant funding, and publication rates, from both successful and unsuccessful 2008--2018 KL2/CMeRIT applicants were compiled throughout the year 2020. Data were obtained directly through outreach to both groups and through assessment of online resources. The cohort comprised 487 individuals, 109 awardees, and 378 nonawardees. Awardees were more likely to be subsequently involved in clinical and translational research than nonawardees (92\% vs 75\%, p {$<$} 0.001). A higher proportion of awardees also had achieved academic promotion (81\% vs 69\%, p = 0.016) and subsequent NIH funding (72\% vs 58\%, p = 0.047), while there was no difference in publication rates (p = 0.555). Participants in the Harvard Catalyst KL2/CMeRIT program demonstrate greater early career success than nonparticipants though the nonparticipants also fared relatively well.},
  langid = {english},
  file = {/home/lc/Zotero/storage/227F2VDP/Bredella-2022-Impact of the KL2_Catalyst Medic.pdf;/home/lc/Zotero/storage/9DU35W4N/Bredella-2022-Impact of the KL2_Catalyst Medic.pdf;/home/lc/Zotero/storage/F4INPCEI/Bredella-2022-Impact of the KL2_Catalyst Medic.pdf}
