@article{mercerMappingLeadershipDevelopment2021,
  ids = {mercerMappingLeadershipDevelopment2021a},
  title = {Mapping the leadership development of UK (full) professors in terms of cognitive, experiential, humanist and social learning},
  author = {Mercer, J.},
