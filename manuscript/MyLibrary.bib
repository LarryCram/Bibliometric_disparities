@article{kimPersonalitySegmentationOptimal2023,
  title = {Personality Segmentation for Optimal Health Care: A Review and Proposed Segmentation Approach},
  author = {Kim, J and Jasper, A and Baek, Y and Martin, P},
  year = 2023,
  month = dec,
  journal = {PSYCHOLOGICAL STUDIES},
  volume = {68},
  number = {4},
  pages = {481--488},
  issn = {0033-2968},
  doi = {10.1007/s12646-023-00749-z},
  abstract = {It is well established that there are interindividual differences in many areas of well-being, such as physical, mental, and functional health, as well as in health behaviors. In the exploration of predictors of health behaviors and outcomes, the relevance of individual differences remains unclear. Thus, the purpose of this literature review article is to investigate various ways in which differences among individuals can be accounted for by segmenting the population. Addressing individual differences through segmenting individuals into meaningful groups is argued as central to optimizing communication among older adults and their health providers. Previous health care research has targeted groups in a variety of ways, including demographic characteristics and heath needs. This literature review included an examination of existing segmentation approaches in health care. Person-centered approaches to health that segments based on health status and health difficulties were examined. Demographic segmentation (e.g., age, gender, and race/ethnicity) and its use in health care was also examined. In addition, we propose an approach to segment groups by individual differences in personality. The results indicate that the five-factor personality traits were associated with health behaviors and outcomes. Based on previous segmentation research and work connecting demographic characteristics, personality traits, and health activation to health outcomes, a novel person-centered approach is proposed to provide optimal health care based on health personality.},
  langid = {english},
  keywords = {5-FACTOR MODEL,CONSCIENTIOUSNESS,Health care,INTRAINDIVIDUAL VARIABILITY,MARKET-SEGMENTATION,MEDICINE,OLDER-ADULTS,OUTCOMES,PATIENT ACTIVATION,Person-centered,Personality,PRODUCT DIFFERENTIATION,Segmentation}
}

