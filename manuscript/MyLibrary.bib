@incollection{richesonSocialPsychologyRace2016,
  title = {Toward a Social Psychology of Race and Race Relations for the Twenty-First Century},
  booktitle = {ANNUAL REVIEW OF PSYCHOLOGY, VOL 67},
  author = {Richeson, {\relax JA} and Sommers, {\relax SR}},
  editor = {Fiske, {\relax ST}},
  year = 2016,
  volume = {67},
  pages = {439--463},
  doi = {10.1146/annurev-psych-010213-115115},
  abstract = {The United States, like many nations, continues to experience rapid growth in its racial minority population and is projected to attain so-called majority-minority status by 2050. Along with these demographic changes, staggering racial disparities persist in health, wealth, and overall well-being. In this article, we review the social psychological literature on race and race relations, beginning with the seemingly simple question: What is race? Drawing on research from different fields, we forward a model of race as dynamic, malleable, and socially constructed, shifting across time, place, perceiver, and target. We then use classic theoretical perspectives on intergroup relations to frame and then consider new questions regarding contemporary racial dynamics. We next consider research on racial diversity, focusing on its effects during interpersonal encounters and for groups. We close by highlighting emerging topics that should top the research agenda for the social psychology of race and race relations in the twenty-first century.},
  isbn = {0066-4308},
  langid = {english},
  keywords = {AFRICAN-AMERICANS,CATEGORY DIVERSITY,COLOR-BLINDNESS,discrimination,diversity,EMOTIONAL-REACTIONS,EXECUTIVE FUNCTION,GROUP IDENTIFICATION,INTERETHNIC IDEOLOGY,INTERGROUP CONTACT,intergroup relations,INTERRACIAL ROOMMATE RELATIONSHIPS,racial categorization,RACIAL DIVERSITY,racial identity,stereotyping and prejudice},
  file = {/home/lc/Zotero/storage/M2QP33JE/Richeson and Sommers - 2016 - Toward a Social Psychology of Race and Race Relations for the Twenty-First Century.pdf}
}

@article{rickerLetterEditorQuality2017,
  title = {Letter to the Editor: About the quality and impact of scientific articles},
  shorttitle = {Letter to the Editor},
  author = {Ricker, Martin},
  year = 2017,
  month = jun,
  journal = {Scientometrics},
  volume = {111},
  number = {3},
