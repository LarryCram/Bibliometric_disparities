@article{javdaniGENDEREDSOCIALFORCES2011,
  title = {GENDERED SOCIAL FORCES A Review of the Impact of Institutionalized Factors on Women and Girls' Criminal Justice Trajectories},
  author = {Javdani, S and Sadeh, N and Verona, E},
