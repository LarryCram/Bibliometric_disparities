  keywords = {BIOTECHNOLOGY,CORPORATE ENTREPRENEURSHIP,DETERMINANTS,FIRMS,IMPACT,MODEL,PERFORMANCE,RISK-AVERSION,SOCIOECONOMIC-STATUS,TRANSFORMATION}
