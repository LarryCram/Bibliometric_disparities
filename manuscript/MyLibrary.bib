@article{shepherdEntrepreneurialSpiralsDeviationAmplifying2010,
  title = {Entrepreneurial Spirals: Deviation-Amplifying Loops of an Entrepreneurial Mindset and Organizational Culture},
  author = {Shepherd, {\relax DA} and Patzelt, H and Haynie, {\relax JM}},
  year = 2010,
