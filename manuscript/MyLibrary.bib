@article{levyLivingTheoryPedagogical2006,
  title = {'Living' theory: a pedagogical framework for process support in networked learning},
  author = {Levy, Philipa},
  year = 2006,
  journal = {ALT-J},
  volume = {14},
  number = {3},
  pages = {225--240},
  issn = {0968-7769},
  abstract = {This paper focuses on the broad outcome of an action research project in which practical theory was developed in the field of networked learning through case-study analysis of learners\^a\texteuro ™ experiences and critical evaluation of educational practice. It begins by briefly discussing the pedagogical approach adopted for the case-study course and the action research methodology. It then identifies key dimensions of four interconnected developmental processes\^a\texteuro ''orientation, communication, socialisation and organisation\^a\texteuro ''that were associated with \^a\texteuro\texttildelow learning to learn\^a\texteuro ™ in the course\^a\texteuro ™s networked environment, and offers a flavour of participants\^a\texteuro ™ experiences in relation to these processes. A number of key evaluation issues that arose are highlighted. Finally, the paper presents the broad conceptual framework for the design and facilitation of process support in networked learning that was derived from this research. The framework proposes a strong, explicit focus on support for process as well as domain learning, and progression from tighter to looser design and facilitation structures for process-focused (as well as domain-focused) learning tasks.}
}

@article{lewisFinancialEvaluationWorkStudy1987,
  title = {The Financial Evaluation of Work-Study Alternatives Facing School-Leavers},
  author = {Lewis, D. E.},
  year = 1987,
  journal = {Higher Education Research and Development},
  volume = {6},
  number = {1},
