@article{pastor-satorrasDistinctTypesEigenvector2016,
  title = {Distinct types of eigenvector localization in networks},
  author = {{Pastor-Satorras}, Romualdo and Castellano, Claudio},
  year = 2016,
  month = jan,
  journal = {Scientific Reports},
  volume = {6},
  pages = {18847},
  issn = {2045-2322},
  doi = {10.1038/srep18847},
  urldate = {2025-10-28},
  abstract = {The spectral properties of the adjacency matrix provide a trove of information about the structure and function of complex networks. In particular, the largest eigenvalue and its associated principal eigenvector are crucial in the understanding of nodes' centrality and the unfolding of dynamical processes. Here we show that two distinct types of localization of the principal eigenvector may occur in heterogeneous networks. For synthetic networks with degree distribution P(q)\,\textasciitilde\,q-{$\gamma$}, localization occurs on the largest hub if {$\gamma$}\,{$>$}\,5/2; for {$\gamma$}\,{$<$}\,5/2 a new type of localization arises on a mesoscopic subgraph associated with the shell with the largest index in the K-core decomposition. Similar evidence for the existence of distinct localization modes is found in the analysis of real-world networks. Our results open a new perspective on dynamical processes on networks and on a recently proposed alternative measure of node centrality based on the non-backtracking matrix.},
  pmcid = {PMC4709588},
  pmid = {26754565},
  file = {/home/lc/Zotero/storage/CI6P4RTE/Pastor-Satorras and Castellano - 2016 - Distinct types of eigenvector localization in networks.pdf;/home/lc/Zotero/storage/ZBNAU5PK/Pastor-Satorras and Castellano - 2016 - Distinct types of eigenvector localization in networks.pdf}
}

