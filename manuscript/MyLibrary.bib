@article{braamMappingScienceCombinedMay19912019-11-23,
  title = {Mapping of Science by Combined Co-Citation and Word Analysis. I. Structural Aspects},
  author = {Braam, Robert R. and Moed, Henk F. and Anthony, F. J. van Raan},
  year = {May 1991 2019-11-23},
  journal = {Journal of the American Society for Information Science (1986-1998)},
  volume = {42},
  number = {4},
  pages = {233},
  issn = {00028231},
  abstract = {The claim that co-citation analysis is a useful tool to map subject-matter specialties of scientific research in a given period, is examined. A method has been devel oped using quantitative analysis of content-words re lated to publications in order to: (1) study coherence of research topics within sets of publications citing clus ters, i.e., (part of) the "current work" of a specialty; (2) to study differences in research topics between sets of publications citing different clusters; and (3) to evalu ate recall of "current work" publications concerning the specialties identified by co-citation analysts. Empirical support is found for the claim that co-citation analysis identifies indeed subject-matter specialties. However, different clusters may identify the same specialty, and results are far from complete concerning the identified "current work." These results are in accordance with the opinion of some experts in the fields. Low recall of co-citation analysts concerning the "current work" of specialties is shown to be related to the way in which researchers build their work on earlier publications: the "missed" publications equally build on very recent ear tier work, but are less "consensual" and/or less "atten tive" in their referencing practice. Evaluation of national research performance using co-citation analysis ap pears to be biased by this "incompleteness."},
  langid = {english},
  keywords = {Auditory system,Bibliometrics,Citation analysis,Citation indexes,Clusters,Cocitation,Content analysis,Documents,Empirical analysis,Handbooks,Information science,Library And Information Sciences,Mapping,Pears,Publications,Quantitative analysis,Recall,Research,Researchers,Science,Scientometrics,Society,Topics},
  file = {/home/lc/Zotero/storage/LJ9HBQ8A/Braam mapping science 1.pdf}
}

