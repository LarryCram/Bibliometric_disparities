@article{srivastavaAspirationalConsumptionBottom2020,
  title = {Aspirational consumption at the bottom of pyramid: A review of literature and future research directions},
  author = {Srivastava, A and Mukherjee, S and Jebarajakirthy, C},
  year = 2020,
  month = mar,
  journal = {JOURNAL OF BUSINESS RESEARCH},
  volume = {110},
  pages = {246--259},
  issn = {0148-2963},
  doi = {10.1016/j.jbusres.2019.12.045},
  abstract = {Customers at the bottom of the pyramid (BOP) desire to use the same products as affluent consumers. Thus, BOP customers tend to participate in aspirational consumption. The purpose of this study is to conduct a systematic literature review and to synthesise the literature on aspirational consumption in BOP contexts to gain a comprehensive understanding of it. Among other findings, this review synthesises factors that drive aspirational consumption and the consequences of aspirational consumption in BOP contexts. This study also suggests insightful directions for further research on aspirational consumption in BOP contexts. Our study advances BOP and consumer behaviour literature by examining an emergent domain of aspirational consumption at the BOP. Our study also outlines some insightful practical and social implications.},
  langid = {english},
  keywords = {Aspirational consumption,BASE,Bottom of the pyramid market,BRAND,Compensatory consumption theory,CONSPICUOUS CONSUMPTION,CONSUMERS NEED,Demonstration of social status,LUXURY CONSUMPTION,MARKET CREATION,PERCEPTIONS,POVERTY,SELF-ESTEEM,SOCIAL COMPARISONS}
}

@article{sShortSurveyBitcoin2024,
  title = {A Short Survey on Bitcoin Price Prediction},
  author = {S, Bistarelli and Francesco, Santini and Luca, Maria Tutino},
  year = 2024,
  journal = {International Conference on Developments in Language Theory},
  abstract = {Bitcoin and other cryptocurrencies have emerged as decentralized digital payment systems driven solely by blockchain technology and supply and demand dynamics. Predicting their prices has become a significant field of research with important implications in automated trading. This study conducts a Systematic Literature Review (SLR) to identify the most common features and models used in recent works for Bitcoin price prediction. Employing an ad hoc method to automate the survey procedure, a summary table is constructed to extract pertinent information. The objective is to discern the performance of various features and models across different data ranges and resolutions, laying the groundwork for developing an effective automated trading system. By synthesizing findings from the literature, this study aims to provide insights into the state-of-the-art methodologies for cryptocurrency price prediction, facilitating informed decision-making for market agents.}
}

