  keywords = {Assessment,DETERMINANTS,Financing,FRAMEWORK,INNOVATION,Intellectual capital,KNOWLEDGE SPILLOVERS,MANAGEMENT,PERFORMANCE,Performance measures,PRODUCT,Research and development,SERVICES,TEAMS}
