  title = {TO DISCLOSE OR NOT TO DISCLOSE? STATUS DISTANCE AND SELF-DISCLOSURE IN DIVERSE ENVIRONMENTS},
  author = {Phillips, {\relax KW} and Rothbard, {\relax NP} and Dumas, {\relax TL}},
