@article{hallewellPicturesTellThousand2017,
  title = {Do pictures `tell' a thousand words in lectures? How lecturers vocalise photographs in their presentations},
  author = {Hallewell, M. J. and Lackovic, N.},
  year = 2017,
  journal = {Higher Education Research and Development},
  volume = {36},
  number = {6},
  pages = {1166--1180},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2017.1303454},
  abstract = {This article explores how 145 photographs collected from 20 PowerPoint lectures in undergraduate psychology at 16 UK universities were integrated with lecturers' speech. Little is currently known about how lecturers refer to the distinct types of photographs included in their presentations. Findings show that only 48 photographs (33\%) included in presentation slides were referred to explicitly by exploring their features to make a point related to the lecture content, with only 14 of these used to invite student questioning. Most photographs (97 or 67\%) represent a case of `unprobed representations', that is, either `embedded' in the talk as `illustrations' of the speech topic or not referred to at all. A taxonomy of uses that lecturers made of the photographs in their slideshows was created through adapting a Peircean semiotic analysis of the photograph--speech interaction. The implications in terms of lecturer and student engagement with the photographic material are discussed, arguing the case for more Critical Semiotic Exploration of photographs in HE practice. \copyright{} 2017 HERDSA.},
  langid = {english},
  keywords = {Higher Education,images,Lecture,PowerPoint,semiotics},
  file = {/home/lc/Zotero/storage/HI5LM2FB/Hallewell and Lackovic - 2017 - Do pictures ‘tell’ a thousand words in lectures How lecturers vocalise photographs in their present.pdf}
}

@article{hallFollowingMoneyLaw2026,
  title = {Following the Money and the Law: Why Legal Form and Funding Models Matter for NGOs},
  author = {Hall, N},
  year = 2026,
  month = mar,
  journal = {INTERNATIONAL STUDIES REVIEW},
  volume = {28},
  number = {1},
  issn = {1521-9488},
  doi = {10.1093/isr/viaf022},
  abstract = {Non-governmental organizations (NGOs) are operating in a challenging environment as governments are shrinking civic space and there is increasing competition for funding. Scholars have begun to examine how NGOs are adapting to these external challenges, but IR scholars have not yet systematically studied variation in their legal status and funding models. This article draws on scholarship from the NGO, not-for-profit, and political science literature, as well as publicly available datasets of NGOs' legal status and finances. It identifies differences in legal form and funding models across large, well-established international NGOs. NGOs are often registering with multiple legal types, which enables them to adapt to shrinking civic space and engage in partisan politics. In addition, NGOs have different funding models; some rely on member donations, while others rely on large grants from philanthropic donors and/or the government. These funding models lead to different accountability dilemmas: member capture and donor capture. If IR scholars were to examine in detail the legal forms and funding models of NGOs, it would enrich our existing theories of resource competition, accountability, population ecology and shrinking civic space. It would also open new, exciting research agendas into the relationship between issue-based advocacy and partisan politics.},
  langid = {english},
  keywords = {ADVOCACY,civil society,CIVIL-SOCIETY,CYCLES,financing,GLOBAL GOVERNANCE,INTERNATIONAL NORMS,legal form,NGOs,POLICY,POLITICAL OPPORTUNITY,POWER,STRATEGIES,transnational advocacy,TRANSNATIONAL NETWORKS}
}

@article{hallGenderAccuracyDecoding2025,
  title = {Gender and Accuracy in Decoding Affect Cues: A Meta-Analysis},
  author = {Hall, {\relax JA} and Gunnery, {\relax SD} and Schlegel, K},
  year = 2025,
  month = mar,
  journal = {JOURNAL OF INTELLIGENCE},
  volume = {13},
  number = {3},
  issn = {2079-3200},
  doi = {10.3390/jintelligence13030038},
  abstract = {Gender differences in understanding the meanings of affect cues, often labeled emotion recognition, have been studied for over a century. Past reviews of the literature have concluded that girls and women score higher than boys and men on tests of accuracy in decoding affect cues, which are most often tested in the cue modalities of face, body, and content-free voice. The present meta-analysis updates knowledge on this topic by including many more studies (1188 effect sizes in 1011 studies; total N = 837,637) and examining a wide range of moderators such as health status of sample, international location, cue channels of the test, and other sample and test characteristics. Indeed, the gender difference favoring girls and women still exists, and evidence for publication bias was weak. The difference is not large (r = 0.12, d = 0.24), but it is extremely consistent across many moderators, which, even when significant, show minor differences. Health status was the only moderator to produce groups without a significant gender difference.},
  langid = {english},
  keywords = {ABILITY,affect,CHILDREN,COMMUNICATION,cues,decoding,emotion recognition,EMOTION RECOGNITION,EMPATHIC ACCURACY,FACIAL EXPRESSIONS,gender,INTELLIGENCE,PERFORMANCE,RELIABILITY,SEX-DIFFERENCES},
