@article{lowryCMCInteractivityModel2009SUM,
  title = {The CMC Interactivity Model: How Interactivity Enhances Communication Quality and Process Satisfaction in Lean-Media Groups},
  author = {Lowry, {\relax PB} and Romano, {\relax NC} and Jenkins, {\relax JL} and Guthrie, {\relax RW}},
  year = {2009 SUM},
  journal = {JOURNAL OF MANAGEMENT INFORMATION SYSTEMS},
  volume = {26},
  number = {1},
  pages = {155--195},
  issn = {0742-1222},
  doi = {10.2753/MIS0742-1222260107},
  abstract = {Process satisfaction is one important determinant of work group collaborative system adoption, continuance, and performance. We explicate the computer-mediated communication (CMC) interactivity model (CMCIM) to explain and predict how interactivity enhances communication quality that results in increased process satisfaction in CMC-supported work groups. We operationalize this model in the challenging context of very large groups using extremely lean CMC. We tested it with a rigorous field experiment and analyzed the results with the latest structural equation modeling techniques. Interactivity and communication quality dramatically improved for very large groups using highly lean CMC (audience response systems) over face-to-face groups. Moreover, CMC groups had fewer negative status effects and higher process satisfaction than face-to-face groups. The practical applications of lean CMC rival theoretical applications in importance because lean CMC is relatively inexpensive and requires minimal training and support compared to other media. The results may aid large global work group continuance, satisfaction, and performance in systems, product and strategy development, and other processes in which status effects and communication issues regularly have negative influences on outcomes.},
  langid = {english},
  keywords = {audience response systems,CMC interactivity model (CMCIM),collaboration,COMPUTER,CUSTOMER SATISFACTION,EXPECTATION-CONFIRMATION,FACE-TO-FACE,GROUP DECISION-MAKING,GROUP SUPPORT-SYSTEMS,GROUP-SIZE,human-computer interaction (HCI),INFORMATION-TECHNOLOGY,interactivity,large groups,SOCIAL PRESENCE,ultra-lean interactive media,ultra-lean interactivity,USER SATISFACTION}
