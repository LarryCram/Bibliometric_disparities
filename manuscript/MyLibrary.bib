  keywords = {AFFECTIVE STYLE,BREAST-CANCER,FRONTAL BRAIN ASYMMETRY,IMMUNE FUNCTION,LIFE EVENTS,MARITAL DISRUPTION,OLDER ADULTS,SOCIAL SUPPORT,SOCIOECONOMIC-STATUS,WELLNESS MOTIVATION}
}

@article{rymanModernWeberianThesis2007,
  title = {The modern Weberian thesis: a short review of the literature},
  author = {Ryman, {\relax JA} and Turner, {\relax CA}},
  year = 2007,
  journal = {JOURNAL OF ENTERPRISING COMMUNITIES-PEOPLE AND PLACES IN THE GLOBAL ECONOMY},
  volume = {1},
