  keywords = {Big data,BUSINESS INTELLIGENCE,CAPABILITIES,Data analytics,DATA ANALYTICS,Data-driven marketing,DETERMINANTS,EXPORT PERFORMANCE,FIRM RESOURCES,IMPACT,International marketing,Internationalization,KNOWLEDGE MANAGEMENT,OPPORTUNITIES,SMEs,SMES}
