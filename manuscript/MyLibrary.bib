}

@article{ackerFootRevolvingDoor2014,
  title = {A foot in the revolving door? Women academics in lower-middle management},
  author = {Acker, S.},
  year = 2014,
  journal = {Higher Education Research and Development},
  volume = {33},
  number = {1},
  pages = {73--85},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360.2013.864615},
  abstract = {This article looks at a small group of women in Canadian faculties of education who hold what I call 'lower-middle management' positions and considers whether they are on the ladder to recognized academic leadership or are in a revolving-door situation that will take them back to the ranks from whence they came. These nine women are associate chairs, associate deans or coordinators. After a review of selected literature on women and academic leadership and a discussion of method, I analyze aspects of the participants' entry into the position, their experience while doing it and (where relevant) their exit. For most, the positions were stressful and did not attract them to leadership careers. The universities are losing out, too, by not preparing, helping or mentoring these dedicated and hard-working individuals. \copyright{} 2014 \copyright{} 2014 HERDSA.},
  langid = {english},
