  keywords = {China,Competences,Competency modelling,FIRMS,HRM,Human resource competency,Human resource strategies,HUMAN-RESOURCE MANAGEMENT,Integrated talent management,INVENTORY,MATTER,PERFORMANCE,REGISTERED NURSES,SCALE,SELECTION,Strategic human resources,TAXONOMY,Traditional job analysis}
