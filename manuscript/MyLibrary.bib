@article{wangMiningAuthorRelationship2017,
  title = {Mining author relationship in scholarly networks based on tripartite citation analysis},
  author = {Wang, Feifei and Wang, Xiaohan and Yang, Siluo},
  year = 2017,
  month = nov,
  journal = {Plos One},
  volume = {12},
