  langid = {english},
  file = {/home/lc/Zotero/storage/UW7CMSJX/Albarrán and Ruiz-Castillo - 2011 - References made and citations received by scientific articles.pdf;/home/lc/Zotero/storage/KL5HV8UB/asi.html}
