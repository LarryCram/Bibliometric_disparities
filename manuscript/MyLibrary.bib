@article{solerRationalIndicatorScientific04//2007,
  ids = {solerRationalIndicatorScientific2007},
  title = {A rational indicator of scientific creativity},
  author = {Soler, Jos{\'e} M.},
  year = {4// 2007},
  journal = {Journal of Informetrics},
  volume = {1},
  number = {2},
  pages = {123--130},
  issn = {1751-1577},
  doi = {http://dx.doi.org/10.1016/j.joi.2006.10.004},
  abstract = {A model is proposed for the creation and transmission of scientific knowledge, based on the network of citations among research articles. The model allows to assign to each article a non-negative value for its creativity, i.e. its creation of new knowledge. If the entire publication network is truncated to the first neighbors of an article (the n references that it makes and the m citations that it receives), its creativity value becomes a simple function of n and m. After splitting the creativity of each article among its authors, the cumulative creativity of an author is then proposed as an indicator of her or his merit of research. In contrast with other merit indicators, this creativity index yields similar values for the top scientists in two very different areas (life sciences and physics), thus offering good promise for interdisciplinary analyses.},
  keywords = {Citation analysis,Citation network,Knowledge flow,Research merit,Scientific creativity},
  file = {/home/lc/Zotero/storage/48Q56P9K/Soler-2007-A rational indicator of scientific.pdf;/home/lc/Zotero/storage/IG94UECL/Soler-2007-A rational indicator of scientific.pdf}
}

@article{soleymanzadehBibliometricAnalysisResource2025,
  title = {A bibliometric analysis of resource orchestration research: current status, emerging trends and future research agenda},
  author = {Soleymanzadeh, O and Hajipour, B},
  year = 2025,
  month = feb,
  journal = {MANAGEMENT RESEARCH REVIEW},
  volume = {48},
  number = {4},
  pages = {643--664},
  issn = {2040-8269},
  doi = {10.1108/MRR-12-2023-0953},
  abstract = {Purpose This paper aims to study the bibliometric analysis of resource orchestration research in management and businessareas. Design/methodology/approach The research method is based on a three-step protocol of dataset setting, dataset refining and analyzing the data. First, the 202 published articles in the resource orchestration field were collected from the Web of Science database. Second, the document information was refined. Finally, we used the bibliometric analysis toolbox to investigate the documents. Also, bibliometric analysis in this research has been conducted using VOSviewer and SPSS software. Findings The findings of this research examined the evolution of the resource orchestration theory. Also, this paper has identified five major themes in this field: resource orchestration for entrepreneurship and innovation, orchestrating supply chain, orchestrating information technology resources, orchestrating intangible resources and the role of resource orchestration in small firm performance. Finally, emerging trends in the resource orchestration area include sustainable development, innovation and information technology. Originality/value This paper is the first to use bibliometric analysis to examine resource orchestration theory. Accordingly, this research contributes to the resource orchestration area through the theoretical evolution, underlying streams of research and emerging themes in research topics and methodologies.},
  langid = {english},
  keywords = {Asset orchestration,Bibliometric analysis,DYNAMIC CAPABILITIES,ENTREPRENEURIAL ORIENTATION,FIRM PERFORMANCE,INNOVATION,MANAGEMENT,MODERATING ROLE,Resource management,Resource orchestration,STRATEGIC ENTREPRENEURSHIP,SUPPLY CHAINS,SYSTEMS,VIEW,VOSviewer}
}

