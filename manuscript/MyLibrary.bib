@article{miltonEvaluateImproveLearning2003,
  title = {Evaluate to improve learning: Reflecting on the role of teaching and learning models},
  author = {Milton, J. and Lyons, J.},
  year = 2003,
  journal = {Higher Education Research and Development},
  volume = {22},
  number = {3},
  pages = {297--312},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436032000145158},
  abstract = {Focusing attention on models of teaching and learning during design and development phases can become the key to integrating evaluation in a teaching development project. This article reflects on an experience in planning and conducting an evaluation of a prototype of a new technology-based teaching initiative. The learning experiences designed as part of the prototype were explicitly built on a model of teaching and learning. This had implications for evaluation not recognised in many evaluation manuals. Aligning evaluation to a model of teaching and learning is revealed to be complex in the sense that an initial model needs to be interpreted and extended to include reference to underlying epistemological assumptions. Yet aligning evaluation with an extended model of teaching and learning simplifies and assists the process of evaluation including the choice of methods, analysis of the data and determining improvements. It directly links evaluation to design and development. \copyright{} 2003, Taylor \& Francis Group, LLC.},
  langid = {english}
}

@misc{mindelSafeguardingAcademicLegitimacy2025,
  type = {SSRN Scholarly Paper},
  title = {Safeguarding Academic Legitimacy: Editorial Conflicts of Interest as a Principal-Agent Problem in Elite Business Journals Preprint},
  shorttitle = {Safeguarding Academic Legitimacy},
  author = {Mindel, Vitali and Ciriello, Raffaele},
  year = 2025,
  month = jun,
  number = {5315585},
  eprint = {5315585},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.5315585},
  urldate = {2025-12-23},
  abstract = {The legitimacy of scholarly knowledge rests on the assumption that peer review is impartial, yet its underlying editorial decision-making processes operate with broad discretion, limited transparency, and weak accountability. This study presents the first large-scale empirical audit of editorial conflicts of interest (COIs) in two elite business journals over a 15-year period. We reveal systemic patterns of relational opportunism among a small elite of prolific authors and editors, expressed as editorial decisions involving reciprocal acceptance, past coauthorship, and longstanding professional ties. The top 54 authors (with ten or more articles) are heavily implicated. We estimate the prevalence of editorial COIs to range from just under 50\% (conservative lower bound) to slightly over 60\% (upper bound), with the incidence increasing over time, reaching an all-time peak in 2024. This elite cohort represents just 2.4\% of 2,204 unique contributors, yet accounts for nearly half of the journals' 1,585 refereed articles in this period. These findings indicate that editors' dual role as referees and players structurally places impartiality at odds with self-interest. Drawing on principal-agent theory, we reconceptualise editorial COIs as institutionalised expressions of agency failure within a prestige-driven publishing regime. Editors, nominally serving the scholarly community, often shift their loyalty toward elite peers with whom they share stakes and ties. We propose actionable reforms to strengthen editorial governance, improve journal transparency, and realign institutional incentives. Ultimately, this paper reframes editorial COIs not as occasional breaches but as systemic failures that threaten the legitimacy of business scholarship unless addressed through collective action.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  file = {/home/lc/Zotero/storage/4P8UFTNV/Mindel and Ciriello - 2025 - Safeguarding Academic Legitimacy Editorial Conflicts of Interest as a Principal-Agent Problem in El.pdf}
}

