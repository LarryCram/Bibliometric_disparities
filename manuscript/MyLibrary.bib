@article{pietriFrameworkUnderstandingEffective2024,
  title = {A framework for understanding effective allyship},
  author = {Pietri, {\relax ES} and Moser, {\relax CE} and Derricks, V and Johnson, {\relax IR}},
  year = 2024,
