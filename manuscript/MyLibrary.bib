@article{mongeonJournalCoverageWeb2016,
  title = {The journal coverage of Web of Science and Scopus: a comparative analysis},
  author = {Mongeon, P. and {Paul-Hus}, A.},
  year = 2016,
  journal = {Scientometrics},
  volume = {106},
  number = {1},
  pages = {213--228},
  issn = {01389130 (ISSN)},
  doi = {10.1007/s11192-015-1765-5},
  abstract = {Bibliometric methods are used in multiple fields for a variety of purposes, namely for research evaluation. Most bibliometric analyses have in common their data sources: Thomson Reuters' Web of Science (WoS) and Elsevier's Scopus. The objective of this research is to describe the journal coverage of those two databases and to assess whether some field, publishing country and language are over or underrepresented. To do this we compared the coverage of active scholarly journals in WoS (13,605 journals) and Scopus (20,346 journals) with Ulrich's extensive periodical directory (63,013 journals). Results indicate that the use of either WoS or Scopus for research evaluation may introduce biases that favor Natural Sciences and Engineering as well as Biomedical Research to the detriment of Social Sciences and Arts and Humanities. Similarly, English-language journals are overrepresented to the detriment of other languages. While both databases share these biases, their coverage differs substantially. As a consequence, the results of bibliometric analyses may vary depending on the database used. These results imply that in the context of comparative research evaluation, WoS and Scopus should be used with caution, especially when comparing different fields, institutions, countries or languages. The bibliometric community should continue its efforts to develop methods and indicators that include scientific output that are not covered in WoS or Scopus, such as field-specific and national citation indexes. \copyright{} 2015, Akad\'emiai Kiad\'o, Budapest, Hungary.},
  langid = {english},
  keywords = {Bibliometrics,Citation indexes,Research evaluation,Scopus,Web of Science},
  file = {/home/lc/Zotero/storage/AYJ69YRS/Mongeon and Paul-Hus - 2016 - The journal coverage of Web of Science and Scopus a comparative analysis.pdf}
}

