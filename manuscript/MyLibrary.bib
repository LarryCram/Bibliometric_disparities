@article{powellComparativeEducationAge2020,
  title = {Comparative education in an age of competition and collaboration},
  author = {Powell, J. J. W.},
  year = 2020,
  journal = {Comparative Education},
  volume = {56},
  number = {1},
  pages = {57--78},
  issn = {03050068 (ISSN)},
  doi = {10.1080/03050068.2019.1701248},
  abstract = {Comparative education relies on experiences, expertise, data, and criticism derived from multiple contexts and diverse levels to generate insights, facilitate understanding, and explain change. Marked by connectivity, our contemporary era vastly increases the (potential) diffusion of ideas essential for scientific advance. Three interlocking trends emphasise the growing relevance of comparative educational research. Firstly, competition has become more potent--among scholars, their organisations, and within as across countries. Secondly, educational studies, as science more generally, are increasingly conducted in collaboration--across disciplinary, cultural, linguistic, and organisational boundaries--enhancing the potential for discovery while producing influential scholarship. Thirdly, while educational research and policymaking are increasingly comparative, comparative knowledge stores are often only selectively used. To counter such reductionism, in-depth comparative institutional analysis across divides of academy, politics, and practice remain crucial. The multidisciplinary field must claim its relevance more persuasively, even as scholarly exchange, mobilities, and cultural knowledge endure as vital foundations. \copyright{} 2020, \copyright{} 2020 Informa UK Limited, trading as Taylor \& Francis Group.},
  langid = {english},
  keywords = {academic research,collaboration,Comparative education,comparative institutional analysis,comparative study,competition,competition (economics),diffusion,education,ideas,ideology,institutional framework,policy,policy making}
}

