  keywords = {affective well-being,AFRICAN-AMERICANS,AGE-RELATED DIFFERENCES,aging,COGNITIVE DECLINE,DEPRESSIVE SYMPTOMS,emotion regulation,LIFE-SPAN,LONGITUDINAL EVIDENCE,NEGATIVE AFFECT,OLDER-ADULTS,SOCIOECONOMIC-STATUS,SOCIOEMOTIONAL SELECTIVITY,well-being}
