@article{cooperUniversityTeachersConceptions2002,
  title = {University teachers' conceptions of memorising in learning science},
  author = {Cooper, I. and Frommer, M. and Gordon, S. and Nicholas, J.},
  year = 2002,
  journal = {Higher Education Research and Development},
  volume = {21},
  number = {3},
  pages = {305--321},
  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436022000020797},
  abstract = {This paper describes what a sample of university teachers in science conceive to be the role of memorising and the relationship between memorising and understanding in their disciplines. Sixteen, purposively selected university teachers were interviewed in depth. The university teachers were from three disciplines--mathematics, physiology and physics. Analysis of the data was undertaken from a phenomenographic perspective (Marton, 1988) and indicates a set of conceptions of memorising including memorising as rote learning for reproduction, as facilitating learning--a way to progress--and as a key component of the learning process. Opposing views of the relationship between memorising and understanding were expressed; these were viewed either as unrelated processes or as dynamically interwoven. \copyright{} 2002, Taylor \& Francis Group, LLC.},
