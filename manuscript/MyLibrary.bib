  keywords = {CER,CONCEPTUAL-FRAMEWORK,CSR,employee commitment,employer reputation,FIRMS,IMPACT,JOB-SATISFACTION,MANAGEMENT RESEARCH,ORGANIZATIONAL IDENTIFICATION,PERCEIVED EXTERNAL PRESTIGE,PLS-SEM,signaling theory,SOCIAL-RESPONSIBILITY,STRATEGIES}
}

@article{dohanUsingComputersAnalyze1998,
