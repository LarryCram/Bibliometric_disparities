@article{schiavonOptimismHopeChronic2017,
  title = {Optimism and Hope in Chronic Disease: A Systematic Review},
  author = {Schiavon, {\relax CC} and Marchetti, E and Gurgel, {\relax LG} and Busnello, {\relax FM} and Reppold, {\relax CT}},
  year = 2017,
