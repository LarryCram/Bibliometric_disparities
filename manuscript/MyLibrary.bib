@article{leporiCorePeripheryStructures07//2013,
  ids = {leporiCorePeripheryStructures2013},
  title = {Core--periphery structures in national higher education systems. A cross-country analysis using interlinking data},
  author = {Lepori, Benedetto and Barberio, Vitaliano and Seeber, Marco and Aguillo, Isidro},
  year = {7// 2013},
  journal = {Journal of Informetrics},
