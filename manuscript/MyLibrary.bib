@article{masuiLearningReflectAttribute2005,
  title = {Learning to reflect and to attribute constructively as basic components of self-regulated learning},
  author = {Masui, Chris and {de Corte}, Erik},
  year = 2005,
  journal = {British Journal of Educational Psychology},
  volume = {75},
  number = {3},
  pages = {351--372},
  issn = {00070998},
  abstract = {Background. Higher education is facing a number of problems: adjusting to larger and more heterogeneous student populations, increasing the number of graduating students, and preparing for lifelong learning. Improving learning competence can make a substantial contribution to solving each of these major concerns. The growing knowledge base on self-regulated learning was taken as one of the main starting points for our study. Aims. In this article we report on reflection and attribution as basic components of self-regulated learning. We examine their trainability and their effect on academic performance. This study is part of a wider research project aimed at improving meta-cognitive knowledge as well as affective, conative and regulation skills. The experimental treatment consisted of an integrated set of instructional conditions, which were operationalized in a series of training sessions, as well as practice and transfer tasks. Sample. The participants in this study were 141 first year students of business economics. The experimental group and both control groups each consisted of 47 students. Method. The effects of the learning environment were investigated using a quasi- experimental design. To control for unintended effects of the design the experimental and the first control group had the same number of teaching hours (time-on-task) and both teachers and students were not informed about the experimental design. Attribution and reflection behaviour was measured through specific assignments, study results during and after the intervention period were taken as indicators of academic performance. To test the hypotheses, t tests and effect-sizes were calculated. Results. After the intervention the experimental students showed a higher degree of reflective behaviour than the control students. Moreover, their attribution skills had also measurably improved. The experimental students obtained better study results than their peers in the control groups. Conclusions... ABSTRACT FROM AUTHOR Copyright of British Journal of Educational Psychology is the property of British Psychological Society and its content may not be copied or emailed to multiple sites or posted to a listserv without the copyright holder's express written permission. However, users may print, download, or email articles for individual use. This abstract may be abridged. No warranty is given about the accuracy of the copy. Users should refer to the original published version of the material for the full abstract. (Copyright applies to all Abstracts)},
  keywords = {ACADEMIC achievement,BEHAVIOR,EDUCATION Higher,EXPERIMENTAL design,LEARNING,PERFORMANCE}
}

@article{mathisFAERMeansFoul2018/6/,
  title = {By FAER Means or Foul: The Road to Advancement for the Academic Anesthesiologist},
  author = {Mathis, Michael R. and Tremper, Kevin K.},
  year = {2018/6/},
  journal = {Anesthesia \&amp; Analgesia},
  volume = {126},
  number = {6},
  pages = {1814--1815},
  issn = {0003-2999},
  doi = {10.1213/ane.0000000000002824},
  abstract = {1814 www.anesthesia-analgesia.org June 2018 {$\bullet$} Volume 126 {$\bullet$} Number 6 DOI: 10.1213/ANE.0000000000002824 For the modern-day academic anesthesiologist, a path to success can be a long, winding road of meticulous research, peer-reviewed manuscript submissions, and applications for external grant funding. Current challenges are posed by a physician--scientist pipeline that remains ``long and leaky,'' with research career attrition occurring at multiple stages after graduate degree training.1 Given these obstacles, the National Institute of Health (NIH) has called for enhanced support of early stage investigators, with targeted approaches including increased access to funding agencies, mentoring teams, professional societies, and peer collaboration.2 Within the scope of anesthesiology, the Foundation for Anesthesia Education and Research (FAER) represents one such agency for young investigator support, and through a range of initiatives, it seeks to implement these support strategies set forth by the NIH. To assess the efficacy of FAER in achieving such goals, a previous study by Pagel and Hudetz3 profiled the academic trajectories of FAER grant recipients, analyzing subsequent publications, citations, and NIH funding rates as measures of scholarly output. This group found FAER alumni to establish records of scholarly output consistently exceeding that of average faculty members. However, the study lacked a comparison group of FAER grant applicants who did not receive FAER funding, for which an analysis would have allowed for greater characterization of associations between FAER grant funding and academic productivity. In this issue of Anesthesia \& Analgesia, Speck et al4 seek to build on this prior work through performing a mixed-methods study that examines the impact of the FAER grant program for funded recipients, compared with applicants who did not receive the FAER grant. The authors perform a survey and curriculum vitae analysis of FAER grant applicants to assess for associations between funding status and indicators of academic productivity, including peer-reviewed publications, leadership positions, and subsequent federal grant funding. Interestingly, the authors found that although success rates for subsequent NIH grant applications were comparable between FAER grant recipients and nonrecipients, FAER grant recipients pursued NIH grant applications nearly twice as frequently as nonrecipients. Thus, the authors successfully demonstrate that among survey respondents, FAER grant recipients were associated with an increased intent to pursue subsequent NIH funding. Furthermore, this difference in FAER grant recipient attitudes was not counterbalanced by any decreased overall competitiveness of the NIH grant application. Whether the increased tendency to apply for subsequent NIH grant funding was a result of an actual shift in attitudes of investigators after receiving FAER grant support or simply a marker of anesthesiologist physician--scientists who were more apt to apply for subsequent NIH grant funding remains outside the scope of this study. Regardless of the putative mechanism for seeking and securing subsequent NIH funding, Speck et al4 provide new insight into the academic career trajectories of FAER grant recipients compared to nonrecipients. Although not explicitly addressed in this study, it is notable that the FAER grant application---regardless of acceptance---provides an NIH-style peer review process by which FAER grant applicants receive structured feedback. Through the process of peer review, the NIH intends to provide unbiased, fair, and timely feedback of the potential impact, quality, and scientific merit of research proposed through the use of a standardized, validated impact score.5 In recognizing these core tenets of research appraisal through performing a similar peer review process, FAER offers a valuable opportunity for physician--investigators in their formative years to critically reflect on all aspects of their research that may be necessary for success. By means of an FAER grant application that requires this reflection and an NIH-style peer review process with structured critiques, the FAER grant application process encourages self-selection of anesthesiologist physician--investigators intending to apply for subsequent NIH funding and provides relevant feedback to support them through this process. Further to this point and of relevance to this study, FAER grant support remains a common stepping stone for emerging anesthesiologist physician--scientists, perhaps evidenced by FAER and NIH funding remaining mutually exclusive. Physician--investigators accepting NIH-funded research career development grants (ie, K-Series) relinquish FAER grant support, highlighting 1 conceivable natural progression in research career development and potentially explaining an associated increase in applications for NIH By FAER Means or Foul: The Road to Advancement for the Academic Anesthesiologist},
  langid = {english}
}

@article{mathurPerformanceMeasurementAutomated2011,
  title = {Performance measurement in automated manufacturing},
  author = {Mathur, A and Dangayach, {\relax GS} and Mittal, {\relax ML} and Sharma, {\relax MK}},
  year = 2011,
  journal = {MEASURING BUSINESS EXCELLENCE},
  volume = {15},
  number = {1},
  pages = {77--91},
  issn = {1368-3047},
  doi = {10.1108/13683041111113268},
  abstract = {Purpose - Today's customer-focused paradigm of business environment puts tremendous pressures of quality, delivery, dependability, flexibility and cost on the manufacturing organisation. Automatic manufacturing systems offer several advantages and are increasingly being adopted as a strategy to improve the performance of manufacturing organisations. Automatic manufacturing systems are highly sophisticated and expensive, and it is therefore important to maximise their productivity. Yet, one can improve only what one can measure. Performance measurement is the key to improving performance, and is a prerequisite to diagnosing, trouble-shooting and improving the production system. Accordingly, performance measurement has been attracting increasing attention over the last two decades, and several frameworks have emerged for the design, review, evaluation and improvement of performance measurement systems for businesses and manufacturing organizations. The performance measurement, monitoring and continuous productivity improvement of automatic manufacturing systems has assumed special significance on account of their high investments and operating costs. Design/methodology/approach - A review of the current literature is undertaken to determine the current status and the status of performance measurement in automated production systems. Findings - Overall equipment effectiveness (OEE) has emerged as one important and universally accepted metric for measuring the overall performance of single automatic equipments. OEE has been further adapted and extended into several variations for use as a metric for automatic manufacturing systems consisting of several automatic machines. Originality/value - This paper reviews the recent developments and the current status of performance measurement of automatic manufacturing systems.},
  langid = {english},
  keywords = {Automation,Manufacturing systems,Performance measures}
}

