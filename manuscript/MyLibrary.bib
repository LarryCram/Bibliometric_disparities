  keywords = {COLLECTIVE IDENTITY,DECISION-MAKING,IMPRESSION-MANAGEMENT,INFLUENCE TACTICS,INTEGRATIVE MODEL,JOB-PERFORMANCE,RELATIONAL DEMOGRAPHY,SOCIAL NETWORKS,STEREOTYPE CONTENT,WORK GROUP}
