  urldate = {2026-07-08},
  abstract = {It is argued here that in the presence of joint educational production a simultaneous equations system is not the most appropriate way to view the production of learning and attitude. Instead, an alternative estimation procedure based on canonical correlation is used to estimate the parameters of a joint educational production function. The technique utilizes the canonical variables to yield parameter estimates in terms of the original economic variables. Marginal products and marginal rates of substitution are calculated and gender-related differences are discussed.},
