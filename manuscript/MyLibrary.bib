@article{radicchiDiffusionScientificCredits2009,
  title = {Diffusion of scientific credits and the ranking of scientists},
  author = {Radicchi, Filippo and Fortunato, Santo and Markines, Benjamin and Vespignani, Alessandro},
  year = 2009,
  month = nov,
  journal = {Physical Review E},
