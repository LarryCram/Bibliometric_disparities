@article{kulikMetaanalysisOutcomeStudies1979,
  title = {A meta-analysis of outcome studies of Keller's personalized system of instruction},
  author = {Kulik, J. A. and Kulik, C. l C. and Cohen, P. A.},
  year = 1979,
  journal = {American Psychologist},
  volume = {34},
  number = {4},
  pages = {307--318},
  doi = {10.1037/0003-066X.34.4.307},
  abstract = {Suggests that meta-analysis, the application of statistical methods to results from a large collection of individual studies, may prove useful to social scientists trying to draw reliable and general conclusions from a diverse and voluminous literature. This article describes a meta-analysis of 75 comparative studies of an innovative method of college teaching, F. S. Keller's personalized system of instruction (PSI). The analysis establishes that PSI generally produces superior student achievement, less variation in achievement, and higher student ratings in college courses, but does not affect course withdrawal or student study time in these courses. The analysis also shows that PSI's superiority can be demonstrated in a variety of course settings with a number of different research designs. Certain settings and research designs, however, produce especially sharp differences between PSI and conventional courses. (20 ref) (PsycINFO Database Record (c) 2006 APA, all rights reserved). \copyright{} 1979 American Psychological Association.},
  keywords = {meta-analysis outcome studies of F. S. Keller's individualized system of instruction}
}

@article{kulikResearchAudiotutorialInstruction1979,
  title = {Research on audio-tutorial instruction: A meta-analysis of comparative studies},
