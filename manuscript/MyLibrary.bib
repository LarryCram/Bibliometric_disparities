@article{cuthbertDiscipliningWritingCase2009,
  title = {Disciplining writing: The case for multi-disciplinary writing groups to support writing for publication by higher degree by research candidates in the humanities, arts and social sciences},
  author = {Cuthbert, D. and Spark, C. and Burke, E.},
  year = 2009,
