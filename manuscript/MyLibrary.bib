  issn = {07294360 (ISSN)},
  doi = {10.1080/0729436860050104},
  abstract = {The conventional single-supervisor model of postgraduate teaching has shown itself to be deficient in a number of areas. In this paper, it is argued that a useful supplement to this model would be a course on problems and methods in research for the beginning researcher. The authors describe their experiences with such a course at Griffith University. Evaluation suggests that the course can provide not only formal research guidance, but also a support system of staff and fellow-students which can serve to reduce the intellectual isolation of the postgraduate student. This may lead to lower attrition rates and improve the performance and productivity of the postgraduate student. \copyright{} 1986, Taylor \& Francis Group, LLC. All rights reserved.},
