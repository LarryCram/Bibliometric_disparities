  keywords = {AGREEMENT,COMMUNICATION-RESEARCH,Content analysis,ENGAGEMENT,Literature review,LOOKING,MIDDLE-EAST,PERSPECTIVES,Public relations,SOCIAL MEDIA,STATES,Text mining,The Arab region,WORLD}
