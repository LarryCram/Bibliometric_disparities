  author = {Viskovic, A.},
  year = 2006,
  journal = {Higher Education Research and Development},
  volume = {25},
  number = {4},
  pages = {323--339},
  issn = {07294360 (ISSN)},
  doi = {10.1080/07294360600947285},
  abstract = {This paper discusses issues arising from three case studies of the ways people have become tertiary teachers in a polytechnic, a wananga (Maori tertiary institution) and a university in New Zealand. Despite institutional differences, the teachers gained most of their teaching knowledge and skills on the job, learning informally and experientially, and much less through engaging with formal courses or centrally organized educational development activities. Tertiary teachers belong to groupings such as their institution, discipline, department or teaching team that can be seen as communities of practice, and it is in those contexts that their working knowledge and identities as teachers develop. A communities of practice framework in three parts is proposed for supporting and strengthening tertiary teachers' workplace learning and educational development. \copyright{} 2006, HERDSA.},
  langid = {english},
  keywords = {Communities of practice,Educational development,Tertiary teaching,Workplace learning}
}

