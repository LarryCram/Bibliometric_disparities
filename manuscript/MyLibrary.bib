@article{putraPhilippinesAcquiescentAscension2024,
  title = {The Philippines' acquiescent ascension},
  author = {Putra, {\relax BA}},
  year = 2024,
  month = sep,
  journal = {FRONTIERS IN POLITICAL SCIENCE},
  volume = {6},
  issn = {2673-3145},
  doi = {10.3389/fpos.2024.1444748},
  abstract = {One of the puzzles to the Philippines' middle power status is how it responds to great power rivalries in the Indo-Pacific. As a claimant state to the South China Sea, its responses in the maritime domain could reveal unique foreign policy patterns on how middle powers respond to overlapping maritime borders. However, the middle power literature cannot make sense of the inconsistencies in the Philippines' foreign policy vis-\& agrave;-vis the South China Sea, showcasing deference and defiance policies between 2016 and 2023. This study argues that bridging role theory into middle power literature can retrieve a more nuanced understanding of how middle powers behave. Utilizing primary and secondary data, this qualitative inquiry captures state narratives of the Philippines' role conceptions and concludes: (1) Duterte's abandonment of the US alliance and appeasement to China as 'active independent' and 'anti-imperialist agent' role conceptions; and (2) Marcos's alignment to the US regional order, sea-based power projections, and leverage of the Philippines' arbitral ruling representing 'faithful ally' and 'example' role conceptions. Bridging role theory in assessing maritime diplomatic actions allows for a nuanced understanding of why foreign policy inconsistencies occur.},
  langid = {english},
  keywords = {INDONESIA,middle powers,Philippines,POLICY,role conceptions,ROLE CONCEPTIONS,role theory,Southeast Asian regional dynamics},
  file = {/home/lc/Zotero/storage/YCFK4HKN/Putra - 2024 - The Philippines' acquiescent ascension.pdf}
}

