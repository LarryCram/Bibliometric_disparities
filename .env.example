# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real API keys.

# Clarivate Web of Science Starter API key.
# Used by pipeline/fetch_wos_records.py.
WOS_API=

# Elsevier Scopus API key and institution token (must be correctly paired
# on Elsevier's developer portal - an unpaired InstToken causes request
# failures). The pairing unlocks view=FULL on Abstract Retrieval, which
# returns the complete author list instead of just the first author.
# Used by pipeline/fetch_scopus_records.py.
sco_apikey=
sco_insttoken=

# National Library of Australia (Trove) API v3 key. Auth is an X-API-KEY
# header, not the query-parameter form shown in Trove's own docs.
# Used by pipeline/fetch_trove_records.py.
trove_token=

# OpenAlex API key + contact email. The key is required for
# content.openalex.org (OpenAlex's own re-hosted PDF archive, distinct
# from locations[].pdf_url) - a bare request gets 401; api_key=<key> as a
# query parameter works. This endpoint has a strict external quota
# (100/day) - see the final stage in pipeline/download_oa_pdfs_landing.py,
# which caps itself well under that regardless of how many works qualify.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Roots of the two mounted drives holding data too large for this repo
# (raw/flattened OpenAlex snapshots, downloaded PDFs/TEI, DuckDB scratch
# space). See config.py - every subsidiary path is built from these two.
K_DRIVE=/home/lc/k
M_DRIVE=/home/lc/m
